+/** 每色前 3 枚 token 的边际价值, 每个局面只算一次。
+ * ponytail: 取可见卡需求的最大值, 不做多卡组合规划。 */
+function tokenWeights(s: Sim): Float64Array {
+  const weights = new Float64Array(18);
+  for (let c = 0; c < 6; c++) weights.fill(c === PEARL ? 8 : 1.5, c * 3, c * 3 + 3);
+  const who = s.current, t = s.tokens[who]!, b = s.bonuses[who]!;
+  for (const card of [...s.pyramid, ...s.reserved[who]!]) {
+    if (!card) continue;
+    const sc = simCard(card);
+    if (sc.isAssociate && defaultColorSim(s, who) < 0) continue;
+    const gaps = [0, 0, 0, 0, 0, Math.max(0, sc.cost[0]! - t[PEARL]!)];
+    for (let c = 0; c < 5; c++) gaps[c] = Math.max(0, sc.cost[c + 1]! - b[c]! - t[c]!);
+    const need = gaps.reduce((a, v) => a + v, 0) - t[GOLD]!;
+    if (need <= 0) continue;
+    for (let c = 0; c < 6; c++) {
+      for (let n = 0; n < Math.min(3, gaps[c]!); n++) {
+        weights[c * 3 + n] = Math.max(weights[c * 3 + n]!, (c === PEARL ? 8 : 1.5) + 12 / need);
+      }
+    }
+  }
+  return weights;
+}
